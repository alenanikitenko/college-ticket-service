digraph er {
  rankdir=LR; nodesep=0.6; ranksep=1.1;
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#444444"];
  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef3fb">
    <tr><td colspan="2" bgcolor="#4a6fa5"><font color="white"><b>users</b></font></td></tr>
    <tr><td align="left"><b>PK</b> id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td align="left"><b>UQ</b> email</td><td align="left">VARCHAR(254) NOT NULL</td></tr>
    <tr><td align="left">full_name</td><td align="left">VARCHAR(100) NOT NULL</td></tr>
    <tr><td align="left">role</td><td align="left">student|operator|admin</td></tr>
    <tr><td align="left">password_hash</td><td align="left">VARCHAR(255) NOT NULL</td></tr>
    <tr><td align="left">is_active</td><td align="left">BOOLEAN NOT NULL</td></tr>
    <tr><td align="left">created_at</td><td align="left">DATETIME NOT NULL</td></tr></table>>];
  categories [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#e8f5e9">
    <tr><td colspan="2" bgcolor="#2e7d32"><font color="white"><b>categories</b></font></td></tr>
    <tr><td align="left"><b>PK</b> id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td align="left"><b>UQ</b> name</td><td align="left">VARCHAR(100) NOT NULL</td></tr></table>>];
  tickets [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fff7e0">
    <tr><td colspan="2" bgcolor="#b08900"><font color="white"><b>tickets</b></font></td></tr>
    <tr><td align="left"><b>PK</b> id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td align="left">title</td><td align="left">VARCHAR(100) NOT NULL</td></tr>
    <tr><td align="left">description</td><td align="left">TEXT NOT NULL</td></tr>
    <tr><td align="left">status</td><td align="left">new|in_progress|resolved|closed</td></tr>
    <tr><td align="left">priority</td><td align="left">INTEGER 1..5 NOT NULL</td></tr>
    <tr><td align="left" port="author"><b>FK</b> author_id</td><td align="left">NOT NULL, RESTRICT</td></tr>
    <tr><td align="left" port="assignee"><b>FK</b> assignee_id</td><td align="left">NULL, SET NULL</td></tr>
    <tr><td align="left" port="category"><b>FK</b> category_id</td><td align="left">NOT NULL, RESTRICT</td></tr>
    <tr><td align="left">created_at</td><td align="left">DATETIME NOT NULL</td></tr>
    <tr><td align="left">updated_at</td><td align="left">DATETIME NOT NULL</td></tr></table>>];
  comments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fdecea">
    <tr><td colspan="2" bgcolor="#c62828"><font color="white"><b>comments</b></font></td></tr>
    <tr><td align="left"><b>PK</b> id</td><td align="left">INTEGER</td></tr>
    <tr><td align="left" port="ticket"><b>FK</b> ticket_id</td><td align="left">NOT NULL, CASCADE</td></tr>
    <tr><td align="left" port="author"><b>FK</b> author_id</td><td align="left">NOT NULL, RESTRICT</td></tr>
    <tr><td align="left">text</td><td align="left">TEXT NOT NULL</td></tr>
    <tr><td align="left">created_at</td><td align="left">DATETIME NOT NULL</td></tr></table>>];
  audit [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#f3e5f5">
    <tr><td colspan="2" bgcolor="#6a1b9a"><font color="white"><b>audit_events</b></font></td></tr>
    <tr><td align="left"><b>PK</b> id</td><td align="left">INTEGER</td></tr>
    <tr><td align="left" port="ticket"><b>FK</b> ticket_id</td><td align="left">NOT NULL, CASCADE</td></tr>
    <tr><td align="left" port="actor"><b>FK</b> actor_id</td><td align="left">NOT NULL, RESTRICT</td></tr>
    <tr><td align="left">action</td><td align="left">VARCHAR(50) NOT NULL</td></tr>
    <tr><td align="left">created_at</td><td align="left">DATETIME NOT NULL</td></tr></table>>];
  users:id:e -> tickets:author:w [label="1 : N  автор", arrowhead=crow, arrowtail=tee, dir=both];
  users:id:e -> tickets:assignee:w [label="0..1 : N  исполнитель", arrowhead=crow, arrowtail=odot, dir=both, style=dashed];
  categories:id:e -> tickets:category:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  tickets:id:e -> comments:ticket:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  tickets:id:e -> audit:ticket:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  users:id:e -> comments:author:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both, color="#999999"];
  users:id:e -> audit:actor:w [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both, color="#999999"];
}
