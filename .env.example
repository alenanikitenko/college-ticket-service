# Скопируйте в .env и при необходимости измените значения.
# APP_ENV: dev | test | prod
APP_ENV=dev
DATABASE_URL=sqlite:///./college_tickets.db
# Обязателен в test и prod. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
HOST=127.0.0.1
PORT=8000
# Необязательно: создать администратора при запуске, если его ещё нет
# FIRST_ADMIN_EMAIL=admin@college.edu
# FIRST_ADMIN_PASSWORD=AdminPass123!
